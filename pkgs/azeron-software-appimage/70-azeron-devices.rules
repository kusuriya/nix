# Azeron vendor IDs from the upstream AppImage's linux/udev/99-azeron-devices.rules.
# Grant the active local seat access, not world-writable MODE="0666".
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="16d0", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="16d0", TAG+="uaccess"
# STM32 DFU bootloader used during Azeron firmware updates.
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", TAG+="uaccess"
